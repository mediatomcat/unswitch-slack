# Slack credentials — copy this file to .env and fill in the values.
# .env is gitignored. Never commit real tokens.

# Bot token (xoxb-...). Issued after you install the app into your workspace.
# Found under: Settings → Install App → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) with the connections:write scope. Required for Socket Mode.
# Created under: Settings → Basic Information → App-Level Tokens.
SLACK_APP_TOKEN=xapp-your-app-token

# Signing secret. Found under: Settings → Basic Information → App Credentials.
# Not strictly required in Socket Mode, but kept here for parity and for a future HTTP receiver.
SLACK_SIGNING_SECRET=your-signing-secret
